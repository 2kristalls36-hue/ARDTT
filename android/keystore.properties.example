# Copy to android/keystore.properties (gitignored) or fetch from VPS:
#   ./scripts/fetch-release-keystore.sh
#
# Permanent release key lives on the distribution server:
#   /opt/ardtt-distribution/secrets/

storeFile=keystore/ardtt-release.keystore
storePassword=REPLACE_ME
keyAlias=ardtt
keyPassword=REPLACE_ME
