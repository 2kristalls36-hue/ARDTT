<?xml version="1.0" encoding="utf-8"?>
<!--
  Body under system header (app name + session chronometer).
  Line1: four equal cells — ↓rate ↑rate | ↓total ↑total (monospace, no jump)
  Line2: public IP | path mode
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_rate_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:gravity="start"
            android:maxLines="1"
            android:text="↓   0 бит/с"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />

        <TextView
            android:id="@+id/notif_rate_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:gravity="start"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:text="↑   0 бит/с"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />

        <TextView
            android:id="@+id/notif_total_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:text="↓  0 Б"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />

        <TextView
            android:id="@+id/notif_total_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:text="↑  0 Б"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp">

        <TextView
            android:id="@+id/notif_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="…"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

        <TextView
            android:id="@+id/notif_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:text="Прямое подключение"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
    </LinearLayout>
</LinearLayout>
