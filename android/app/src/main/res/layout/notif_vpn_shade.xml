<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom VPN shade body (under system app icon).
  Header: brand | session 00:00:00 (end-aligned)
  Line1: live rates | session totals (end-aligned)
  Line2: path + public egress IP
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ARDTT"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

        <TextView
            android:id="@+id/notif_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="00:00:00"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp">

        <TextView
            android:id="@+id/notif_rates"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="↓0 Б/с  ↑0 Б/с"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />

        <TextView
            android:id="@+id/notif_totals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:text="↓0 Б  ↑0 Б"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_path_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="3dp"
        android:text="Прямое подключение · —"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
</LinearLayout>
