<?xml version="1.0" encoding="utf-8"?>
<!--
  VPN shade (qWDTT-style plate):
  - System header: ARDTT + chronometer
  - Bold title: Прямое подключение / Обход
  - Line 1: live rates LEFT · session totals RIGHT
  - Line 2: [CF?][RKN?] public IP … path label RIGHT
  No Space / minEms (OEM RemoteViews bugs).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="1dp"
    android:paddingBottom="1dp">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Прямое подключение"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="2dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/notif_stats_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/notif_rates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="↓0.00 Кб/с  ↑0.00 Кб/с"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:id="@+id/notif_totals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="none"
            android:fontFamily="monospace"
            android:gravity="end"
            android:maxLines="1"
            android:text="↓0.00 КБ  ↑0.00 КБ"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp">

        <ImageView
            android:id="@+id/notif_warp_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cloudflare"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/notif_rkn_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_rkn_whitelist"
            android:visibility="gone" />

        <TextView
            android:id="@+id/notif_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="…"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />

        <TextView
            android:id="@+id/notif_path"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="Прямое"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
    </LinearLayout>
</LinearLayout>
