<?xml version="1.0" encoding="utf-8"?>
<!-- Compact ARDTT VPN plate. Brand mark on the left; Cloudflare icon sits before the IP. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/notif_brand"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_logo_full" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Прямое подключение"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingTop="3dp"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notif_stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="3dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/notif_warp_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cloudflare"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/notif_rkn_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_rkn_whitelist"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/notif_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="…"
                    android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/notif_rates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="end"
                android:maxLines="1"
                android:text="↓0 б/с  ↑0 б/с"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
