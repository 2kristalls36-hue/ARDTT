#!/usr/bin/env python3
"""Attach to ARDTT Lab on the phone through an SSH jump host.

The phone app opens SSH and reverse-forwards 127.0.0.1:7422 on the server
to a command socket on the device. This CLI is what the cloud agent runs:

  ./scripts/ardtt-lab --ssh root@vps status
  ./scripts/ardtt-lab --ssh root@vps probe --vps 45.129.2.3
  ./scripts/ardtt-lab --ssh root@vps screenshot -o /tmp/phone.png
  ./scripts/ardtt-lab --ssh root@vps launch
  ./scripts/ardtt-lab --ssh root@vps attach

If you are already on the VPS:

  ./scripts/ardtt-lab status
"""
from __future__ import annotations

import argparse
import base64
import json
import os
import socket
import subprocess
import sys
import time
import uuid
from typing import Any

DEFAULT_PORT = 7422
PORT_FILE = "/tmp/ardtt-lab.port"


def parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Control ARDTT Lab through SSH")
    p.add_argument("--ssh", help="user@host (runs commands on that server via ssh)")
    p.add_argument("--port", type=int, default=0, help="reverse port (default: /tmp/ardtt-lab.port or 7422)")
    p.add_argument("--self-test", action="store_true")
    sub = p.add_subparsers(dest="cmd", required=False)
    sub.add_parser("ping")
    sub.add_parser("status")
    sub.add_parser("launch")
    sub.add_parser("attach")
    pr = sub.add_parser("probe")
    pr.add_argument("--vps", default="")
    pr.add_argument("--vps-port", type=int, default=9100)
    sc = sub.add_parser("screenshot")
    sc.add_argument("-o", "--output", default="ardtt-lab.png")
    return p.parse_args(argv)


def request_obj(cmd: str, **fields: Any) -> dict[str, Any]:
    body = {"id": uuid.uuid4().hex[:8], "cmd": cmd}
    body.update({k: v for k, v in fields.items() if v is not None})
    return body


def encode_line(obj: dict[str, Any]) -> bytes:
    return (json.dumps(obj, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")


def decode_line(raw: bytes) -> dict[str, Any]:
    return json.loads(raw.decode("utf-8").strip())


def local_exchange(port: int, payload: dict[str, Any], timeout: float = 20.0) -> dict[str, Any]:
    sock = socket.create_connection(("127.0.0.1", port), timeout)
    try:
        sock.sendall(encode_line(payload))
        sock.settimeout(timeout)
        buf = b""
        while b"\n" not in buf:
            chunk = sock.recv(65536)
            if not chunk:
                break
            buf += chunk
        if not buf.strip():
            raise RuntimeError("телефон не ответил — приложение Lab не подключено?")
        return decode_line(buf.splitlines()[0])
    finally:
        sock.close()


def remote_python(port: int) -> str:
    return f"""
import json,socket,sys
port=int({port})
payload=sys.stdin.buffer.read()
s=socket.create_connection(("127.0.0.1",port),8)
s.sendall(payload)
s.settimeout(25)
buf=b""
while b"\\n" not in buf:
    chunk=s.recv(65536)
    if not chunk:
        break
    buf += chunk
s.close()
sys.stdout.buffer.write(buf)
"""


def discover_remote_port(ssh: str | None) -> int:
    if ssh:
        out = subprocess.check_output(
            ["ssh", "-o", "BatchMode=yes", ssh, f"cat {PORT_FILE} 2>/dev/null || echo {DEFAULT_PORT}"],
            text=True,
        )
        return int(out.strip().splitlines()[-1])
    if os.path.isfile(PORT_FILE):
        return int(open(PORT_FILE, encoding="utf-8").read().strip() or DEFAULT_PORT)
    return DEFAULT_PORT


def exchange(ssh: str | None, port: int, payload: dict[str, Any]) -> dict[str, Any]:
    if not ssh:
        return local_exchange(port, payload)
    proc = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", ssh, "python3", "-c", remote_python(port)],
        input=encode_line(payload),
        capture_output=True,
        check=False,
    )
    if proc.returncode != 0:
        err = proc.stderr.decode("utf-8", "replace").strip() or proc.stdout.decode("utf-8", "replace")
        raise RuntimeError(err or f"ssh exit {proc.returncode}")
    raw = proc.stdout.strip() or proc.stderr.strip()
    if not raw:
        raise RuntimeError("пустой ответ: Lab не подключён или порт занят другой сессией")
    return decode_line(raw.splitlines()[0])


def print_json(obj: dict[str, Any]) -> None:
    json.dump(obj, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")


def self_test() -> None:
    line = encode_line(request_obj("ping"))
    parsed = decode_line(line)
    assert parsed["cmd"] == "ping"
    assert "id" in parsed
    print("self-test ok")


def attach(ssh: str | None, port: int) -> None:
    print("watching… Ctrl+C to stop", file=sys.stderr)
    while True:
        reply = exchange(ssh, port, request_obj("status"))
        ts = time.strftime("%H:%M:%S")
        wifi = "wifi" if reply.get("wifi_on") else "no-wifi"
        cell = reply.get("operator") or ("lte" if reply.get("cellular") else "no-lte")
        vpn = "vpn" if reply.get("vpn") else "no-vpn"
        print(f"{ts}  {wifi}  {cell}  {vpn}  ardtt={reply.get('ardtt_installed')}")
        time.sleep(3)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.self_test:
        self_test()
        return 0
    if not args.cmd:
        print("укажите команду: ping|status|probe|screenshot|launch|attach", file=sys.stderr)
        return 2
    port = args.port or discover_remote_port(args.ssh)
    if args.cmd == "attach":
        attach(args.ssh, port)
        return 0
    if args.cmd == "ping":
        print_json(exchange(args.ssh, port, request_obj("ping")))
        return 0
    if args.cmd == "status":
        print_json(exchange(args.ssh, port, request_obj("status")))
        return 0
    if args.cmd == "launch":
        print_json(exchange(args.ssh, port, request_obj("launch_ardtt")))
        return 0
    if args.cmd == "probe":
        print_json(
            exchange(
                args.ssh,
                port,
                request_obj("probe", vps=args.vps or None, port=args.vps_port),
            )
        )
        return 0
    if args.cmd == "screenshot":
        reply = exchange(args.ssh, port, request_obj("screenshot"))
        if not reply.get("ok"):
            print_json(reply)
            return 1
        png = base64.b64decode(reply["png_b64"])
        with open(args.output, "wb") as handle:
            handle.write(png)
        print(f"wrote {args.output} ({len(png)} bytes)")
        return 0
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        raise SystemExit(130)
    except Exception as err:
        print(f"ardtt-lab: {err}", file=sys.stderr)
        raise SystemExit(1)
