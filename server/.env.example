# Copy to .env or export before compose up
NVPN_PUBLIC_HOST=YOUR_VPS_IP
NVPN_DIRECT_PORT=51820
NVPN_BYPASS_PORT=56003
NVPN_PROVISION_LISTEN=0.0.0.0:9100
NVPN_WARP_GOMEMLIMIT=400MiB
TELEMETRY_LISTEN=0.0.0.0:9200
NVPN_TELEMETRY_LISTEN=0.0.0.0:9200
NVPN_TELEMETRY_PORT=9200
# entry (default) | exit (hop: AWG + DNS + WARP)
NVPN_ROLE=entry
NVPN_CASCADE_ENABLED=0
NVPN_CASCADE_LISTEN_PORT=51820
NVPN_CASCADE_PEER_ENDPOINT=
NVPN_CASCADE_PEER_PUBLIC_KEY=
# Hop DNS for phone profiles. Ignored unless NVPN_CASCADE_ENABLED=1.
NVPN_CASCADE_DNS=
NVPN_BYPASS_DNS=10.9.0.1
NVPN_WARP_MODE=hideip
NVPN_WARP_DNS_IIFACES=awg0 wdttraw0
