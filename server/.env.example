# Copy to .env or export before compose up
# isolated = own netns (default, does not take over the VPS).
# hostnet  = share the host network (last resort if UDP publish is broken).
COMPOSE_PROFILES=isolated
ARDTT_NETWORK_MODE=isolated
ARDTT_PUBLIC_HOST=YOUR_VPS_IP
ARDTT_DIRECT_PORT=51820
ARDTT_BYPASS_PORT=56003
# 1 = pick free UDP if preferred ports are busy (app default). 0 = fail if busy.
ARDTT_AUTO_PORTS=0
ARDTT_PROVISION_LISTEN=0.0.0.0:9100
ARDTT_WARP_GOMEMLIMIT=400MiB
TELEMETRY_LISTEN=0.0.0.0:9200
ARDTT_TELEMETRY_LISTEN=0.0.0.0:9200
ARDTT_TELEMETRY_PORT=9200
# entry (default) | exit (hop: AWG + DNS + WARP)
ARDTT_ROLE=entry
ARDTT_CASCADE_ENABLED=0
ARDTT_CASCADE_LISTEN_PORT=51820
ARDTT_CASCADE_PEER_ENDPOINT=
ARDTT_CASCADE_PEER_PUBLIC_KEY=
# Hop DNS for phone profiles. Ignored unless ARDTT_CASCADE_ENABLED=1.
ARDTT_CASCADE_DNS=
ARDTT_BYPASS_DNS=10.9.0.1
ARDTT_WARP_MODE=hideip
ARDTT_WARP_DNS_IIFACES=awg0 wdttraw0
# Exit hop only: poll entry for hideIp /32 prefixes.
ARDTT_WARP_HIDEIP_URL=
