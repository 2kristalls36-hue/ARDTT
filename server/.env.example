# Copy to .env or export before compose up.
# Production install (release package) never builds or pulls images.
# Docker Engine is in vendor/docker.tgz and is installed when docker info fails.
# A working Engine is left alone. This file is not an OS bootstrap.

ARDTT_PUBLIC_HOST=YOUR_VPS_IP
ARDTT_IMAGE=ardtt/server:1.0.46
ARDTT_INSTANCE_ID=
ARDTT_CONTAINER_NAME=ardtt
ARDTT_NETWORK_NAME=ardtt-br
ARDTT_BRIDGE_SUBNET=172.28.20.0/24
ARDTT_DATA_DIR=/opt/ardtt/data
ARDTT_LOG_DIR=/opt/ardtt/logs
COMPOSE_PROJECT_NAME=ardtt

# Host published ports (container listens stay 51820/56003/9100/9200).
ARDTT_DIRECT_PORT=51820
ARDTT_BYPASS_PORT=56003
ARDTT_PROVISION_PORT=9100
ARDTT_TELEMETRY_PORT=9200
ARDTT_DIRECT_LISTEN_PORT=51820
ARDTT_BYPASS_LISTEN_PORT=56003
# 1 = pick free host ports when preferred are busy (app default). 0 = fail if busy.
ARDTT_AUTO_PORTS=0

ARDTT_PROVISION_LISTEN=0.0.0.0:9100
TELEMETRY_LISTEN=0.0.0.0:9200
ARDTT_TELEMETRY_LISTEN=0.0.0.0:9200
ARDTT_WARP_GOMEMLIMIT=256MiB
ARDTT_MEM_LIMIT=1g
ARDTT_CPUS=2.0
ARDTT_PIDS_LIMIT=512

# entry (default) | exit (hop: AWG + DNS + WARP)
ARDTT_ROLE=entry
ARDTT_CASCADE_ENABLED=0
ARDTT_CASCADE_LISTEN_PORT=51820
ARDTT_CASCADE_PEER_ENDPOINT=
ARDTT_CASCADE_PEER_PUBLIC_KEY=
# Host published provision port of the other hop (entry→exit /health, egress-ip).
ARDTT_CASCADE_PEER_PROVISION_PORT=9100
# Hop DNS for phone profiles. Ignored unless ARDTT_CASCADE_ENABLED=1.
ARDTT_CASCADE_DNS=
ARDTT_BYPASS_DNS=10.9.0.1
ARDTT_WARP_MODE=hideip
ARDTT_WARP_DNS_IIFACES=awg0 wdttraw0
# Exit hop only: poll entry for hideIp /32 prefixes (overlay 10.10.0.1:9100).
ARDTT_WARP_HIDEIP_URL=

# Isolated netns only. hostnet is not restored from an old .env.
ARDTT_NETWORK_MODE=isolated
